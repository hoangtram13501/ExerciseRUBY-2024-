<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-body-tertiary">
  <!-- Container wrapper -->
  <div class="container">
    <!-- Navbar brand -->
   <!-- Left links -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to "Page List", root_path, class: "nav-link" %>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Team</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Projects</a>
        </li>
      <% if current_user.admin? %>
        <li class="nav-item">
          <%= link_to "Admin", admin_dashboard_path, class: "nav-link btn btn-warning ml-2" %>
        </li>
      <% end %>



      </ul>
      <!-- Left links -->

    <!-- Toggle button -->
    <button
      data-mdb-collapse-init
      class="navbar-toggler"
      type="button"
      data-mdb-target="#navbarButtonsExample"
      aria-controls="navbarButtonsExample"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <i class="fas fa-bars"></i>
    </button>

      <div class="d-flex align-items-center">

        <% if current_user %>
          <div class="dropdown">
            <button class="btn btn-outline-success dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
              Hello, <%= current_user.name %> <!-- Hiển thị tên người dùng -->
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
              <li>
                <%= link_to 'Account', edit_user_registration_path, class: 'dropdown-item' %>
              </li>
              <li>
                <%= link_to 'Logout', '#', data: { controller: "logout", action: "click->logout#submit" }, class: 'dropdown-item' %>
              </li>
            </ul>
          </div>
        <% else %>
          <!-- Hiển thị các liên kết cho người dùng chưa đăng nhập -->
          <%= link_to "Log in", new_session_path(resource_name), class: "btn btn-primary me-2" %>
          <%= link_to "Sign up", new_registration_path(resource_name), class: "btn btn-secondary" %>
        <% end %>

        <a
          data-mdb-ripple-init
          class="btn btn-dark px-3"
          href="https://github.com/mdbootstrap/mdb-ui-kit"
          role="button"
          ><i class="fab fa-github"></i
        ></a>
      </div>
    </div>
    <!-- Collapsible wrapper -->
  </div>
  <!-- Container wrapper -->
</nav>
<!-- Navbar -->
