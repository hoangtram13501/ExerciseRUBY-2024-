<div class="mt-4 p-3 border rounded shadow-sm bg-light">
  <h5 class="mb-3">Friend Requests</h5>

  <div class="friend-requests">
    <% if @friend_requests.present? %>
      <% @friend_requests.each do |friendship| %>
        <div class="friend-request d-flex align-items-center mb-3 p-2 border rounded bg-white" 
             data-controller="friendship" 
             data-friendship-id-value="<%= friendship.id %>">

          <div class="friend-info flex-grow-1">
            <h6 class="mb-1"><%= friendship.sender.name %></h6>
          </div>

          <button class="btn btn-sm btn-success me-2" 
                  data-action="click->friendship#acceptFriend">
            Accept
          </button>

          <button class="btn btn-sm btn-danger" 
                  data-action="click->friendship#declineFriend">
            Decline
          </button>
        </div>
      <% end %>
    <% else %>
      <p>No pending friend requests.</p>
    <% end %>
  </div>
</div>
