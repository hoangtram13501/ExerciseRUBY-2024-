<h1 class="text-center my-4">Quản lý Bài Đăng</h1>

<div class="container">
  <table class="table table-striped table-bordered">
    <thead class="table-dark text-center">
      <tr>
        <th>ID</th>
        <th>Tiêu đề</th>
        <th>Nội dung</th>
        <th>Ngày tạo</th>
        <th>Hành động</th>
      </tr>
    </thead>
    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td class="text-center"><%= post.id %></td>
          <td><%= post.title %></td>
          <td><%= truncate(post.context, length: 50) %></td>
          <td class="text-center"><%= post.created_at.strftime("%d/%m/%Y") %></td>
          <td class="text-center">
            <%= link_to "Sửa", edit_admin_post_path(post), class: "btn btn-warning btn-sm" %>
            <%= link_to "Xóa", admin_post_path(post), method: :delete, data: { confirm: "Bạn có chắc muốn xóa?" }, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
