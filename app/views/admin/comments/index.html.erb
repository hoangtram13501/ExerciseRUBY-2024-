<h1 class="text-center my-4">Quản lý Bình luận</h1>

<div class="container">
  <table class="table table-striped table-bordered">
    <thead class="table-dark text-center">
      <tr>
        <th>ID</th>
        <th>Nội dung</th>
        <th>Người bình luận</th>
        <th>Thời gian</th>
        <th>Hành động</th>
      </tr>
    </thead>
    <tbody>
      <% @comments.each do |comment| %>
        <tr>
          <td class="text-center"><%= comment.id %></td>
          <td><%= comment.content %></td>
          <td class="text-center"><%= comment.user.email %></td>
          <td class="text-center"><%= comment.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="text-center">
            <%= link_to edit_admin_comment_path(comment), class: "btn btn-warning btn-sm" do %>
              <i class="bi bi-pencil-square"></i> Sửa
            <% end %>
            <%= link_to admin_comment_path(comment), data: { turbo_method: :delete, confirm: "Bạn có chắc muốn xóa?" }, class: "btn btn-danger btn-sm" do %>
              <i class="bi bi-trash"></i> Xóa
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
