<h1 class="text-center my-4">Quản lý User</h1>

<div class="container">
  <table class="table table-striped table-bordered">
    <thead class="table-dark text-center">
      <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Name</th>
        <th>Ngày tạo</th>
        <th>Hành động</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="text-center"><%= user.id %></td>
          <td><%= user.email %></td>
          <td><%= user.name %></td>
          <td class="text-center"><%= user.created_at.strftime("%d/%m/%Y") %></td>
            <td class="text-center">
            <%= link_to edit_admin_user_path(user), class: "btn btn-warning btn-sm" do %>
              <i class="bi bi-pencil-square"></i> Sửa
            <% end %>

            <%= button_to admin_user_path(user), method: :delete, data: { confirm: "Bạn có chắc muốn xóa?" }, class: "btn btn-danger btn-sm" do %>
              <i class="bi bi-trash"></i> Xóa
            <% end %>
          </td>

        </tr>
      <% end %>
    </tbody>
  </table>
</div>
